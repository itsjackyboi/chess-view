# Port the relay listens on (behind a WSS reverse proxy in production).
PORT=8080

# Shared secret the Minecraft plugin sends in the `x-plugin-secret` header
# when it connects to /plugin. Must match config.yml on the plugin side.
PLUGIN_SECRET=change-me-plugin-secret

# Secret used to HMAC-sign player UUIDs into client tokens. Must match the
# `token-secret` in the plugin's config.yml so join links verify here.
TOKEN_SECRET=change-me-token-secret

# Optional: absolute path to the static web client. Defaults to ../client.
# CLIENT_DIR=../client
