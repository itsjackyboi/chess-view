{
  "name": "pintland-relay",
  "version": "1.0.0",
  "description": "Relay server for the Pintland region audio system: routes region-change commands from the Minecraft plugin to each player's browser tab over WebSocket.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "token": "node scripts/sign-token.js",
    "mock-plugin": "node scripts/mock-plugin.js",
    "mock-client": "node scripts/mock-client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "license": "MIT"
}
