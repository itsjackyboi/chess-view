{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@chessview/protocol": ["../packages/protocol/src/index.ts"],
      "~/*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx"]
}
